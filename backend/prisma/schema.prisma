// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  OWNER       // Dono do salão
  PROFESSIONAL // Profissional do salão
  ADMIN        // Admin da plataforma
}

enum AppointmentStatus {
  PENDING     // Aguardando confirmação
  CONFIRMED   // Confirmado
  COMPLETED   // Realizado
  CANCELED    // Cancelado
  NO_SHOW     // Não compareceu
}

enum ServiceCategory {
  HAIRCUT
  COLORING
  STYLING
  NAILS
  MASSAGE
  SKINCARE
  LASHES
  WAXING
  OTHER
}

// ============================================================================
// MODELS
// ============================================================================

/// Usuários (Donos de salões, profissionais, admins)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String   // bcryptjs hash
  role      UserRole @default(OWNER)
  
  // Relacionamento com salão
  salon     Salon?   @relation("SalonOwner")
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

/// Salões de beleza / Prestadores de serviço
model Salon {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  owner           User     @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Informações básicas
  name            String
  slug            String   @unique // Para URL pública (ex: studio-ana)
  phone           String
  email           String?
  description     String?
  
  // Endereço
  address         String?
  city            String?
  state           String?
  zipCode         String?
  
  // Configurações de funcionamento
  businessHours   String?  // JSON com horários
  
  // Relacionamentos
  professionals  Professional[]
  services       Service[]
  clients        Client[]
  appointments   Appointment[]
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@map("salons")
}

/// Profissionais (Cabeleireiras, manicures, etc)
model Professional {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  // Informações pessoais
  name          String
  phone         String
  bio           String?
  
  // Relacionamentos
  services      Service[]        @relation("ProfessionalServices")
  appointments  Appointment[]
  
  // Status
  active        Boolean  @default(true)
  
  // Soft delete
  deletedAt     DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([salonId, phone])
  @@map("professionals")
}

/// Serviços oferecidos pelo salão
model Service {
  id                String   @id @default(cuid())
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  // Informações do serviço
  name              String
  description       String?
  category          ServiceCategory @default(OTHER)
  price             Decimal
  durationMinutes   Int      // Duração do atendimento em minutos
  
  // Relacionamentos
  professionals     Professional[]  @relation("ProfessionalServices")
  appointments      Appointment[]
  
  // Status
  active            Boolean  @default(true)
  
  // Soft delete
  deletedAt         DateTime?
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@unique([salonId, name])
  @@map("services")
}

/// Clientes (Pessoas que agendaram)
model Client {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  // Informações pessoais
  name        String
  phone       String   // Pode ter múltiplos clientes com mesmo telefone
  email       String?
  
  // Soft delete
  deletedAt  DateTime?
  
  // Relacionamento
  appointments Appointment[]
  
  // Timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([salonId, phone])
  @@map("clients")
}

/// Agendamentos
model Appointment {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  // Cliente
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Profissional e serviço
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  timeZone        String? @default("America/Fortaleza")  // Para reminders, WhatsApp, automações
  
  // Data e hora
  scheduledAt     DateTime
  
  // Status
  status          AppointmentStatus @default(PENDING)
  
  // Informações adicionais
  notes           String?
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([professionalId, scheduledAt])
  @@index([salonId])
  @@index([clientId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([scheduledAt])
  @@map("appointments")
}
