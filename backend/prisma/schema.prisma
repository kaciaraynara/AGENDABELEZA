generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  OWNER
  PROFESSIONAL
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ServiceCategory {
  HAIRCUT
  COLORING
  STYLING
  NAILS
  MASSAGE
  SKINCARE
  LASHES
  WAXING
  OTHER
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  ASAAS
  STRIPE
}
// ============================================================================
// MODELS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      UserRole @default(OWNER)

  salon     Salon?   @relation("SalonOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Salon {
  id            String @id @default(cuid())
  ownerId       String @unique
  owner         User   @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name          String
  slug          String @unique
  phone         String
  email         String?
  description   String?

  address       String?
  city          String?
  state         String?
  zipCode       String?

  businessHours String?

  // Billing fields
  subscriptionStatus      SubscriptionStatus @default(TRIAL)
  trialEndsAt             DateTime?
  subscriptionEndsAt      DateTime?
  paymentProvider         PaymentProvider?
  providerCustomerId      String?
  providerSubscriptionId  String?
  currentPlan             String?
  isBlocked               Boolean @default(false)

  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("salons")
}

model Professional {
  id       String @id @default(cuid())
  salonId  String
  salon    Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name     String
  phone    String
  bio      String?

  services     Service[]     @relation("ProfessionalServices")
  appointments Appointment[]

  active    Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, phone])
  @@map("professionals")
}

model Service {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  category          ServiceCategory @default(OTHER)
  price             Decimal
  durationMinutes   Int

  costAmount           Decimal? @default(0)
  commissionPercent    Decimal? @default(0)
  desiredMarginPercent Decimal? @default(30)
  suggestedPrice       Decimal?
  finalPrice           Decimal?
  pricingNotes         String?

  professionals Professional[] @relation("ProfessionalServices")
  appointments  Appointment[]

  active    Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, name])
  @@map("services")
}

model Client {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  deletedAt DateTime?

  internalNotes     String?
  lastVisitAt       DateTime?
  lastMessageSentAt DateTime?
  loyaltyScore      Int       @default(0)
  clientTag         String?
  noShowCount       Int       @default(0)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, phone])
  @@map("clients")
}

model Appointment {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  scheduledAt DateTime
  timeZone    String? @default("America/Fortaleza")

  status AppointmentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, scheduledAt])
  @@index([salonId])
  @@index([clientId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([scheduledAt])
  @@map("appointments")
}