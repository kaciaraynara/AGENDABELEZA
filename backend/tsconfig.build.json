{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "prisma/migrations",
    "src/__tests__",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
