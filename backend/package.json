{
  "name": "agenda-beleza-backend",
  "version": "0.1.0",
  "description": "SaaS para salões de beleza - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "tsc --noEmit",
    "test:coverage": "jest --forceExit --coverage"
  },
  "keywords": [
    "salon",
    "appointments",
    "scheduling",
    "beauty",
    "saas"
  ],
  "author": "AgendaBeleza Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "autocannon": "^8.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.2.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "stripe": "^22.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
